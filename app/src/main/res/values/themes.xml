<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HocTiengTrung" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/green</item>
        <item name="android:colorPrimaryDark">@color/green_dark</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:actionBarStyle">@style/ActionBar.HocTiengTrung</item>
        <item name="android:statusBarColor">@color/green_dark</item>
    </style>

    <style name="ActionBar.HocTiengTrung" parent="android:Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/green</item>
        <item name="android:titleTextStyle">@style/ActionBarTitle.HocTiengTrung</item>
    </style>

    <style name="ActionBarTitle.HocTiengTrung" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">19sp</item>
    </style>
</resources>
